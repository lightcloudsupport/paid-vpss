# ── Required ─────────────────────────────
DISCORD_TOKEN=your-bot-token
# Comma separated Discord user IDs. Owners are permanent admins.
OWNER_IDS=123456789012345678

# ── Optional ─────────────────────────────
BRAND_NAME=LightCloud
LOGO_URL=
EMBED_COLOR=0x2ECC71
# Set to your server ID for instant slash-command sync (leave empty for global)
GUILD_ID=
# Public IP / domain of this node (shown for port forwards)
PUBLIC_IP=0.0.0.0
# Container name prefix
VPS_PREFIX=lc-
DEFAULT_IMAGE=images:ubuntu/22.04
# Port-forward range handed out to paid users
PORT_RANGE_START=20000
PORT_RANGE_END=29999
# cPanel / web panel URL template. {name} = vps name, {ip} = vps IP
PANEL_URL=
# Where admins post logs (optional channel ID)
LOG_CHANNEL_ID=
